# 只绑定当前已核私网接口，默认loopback；不要写0.0.0.0或公网地址。
OBS_BIND_IP=127.0.0.1
OTLP_HTTP_PORT=14318
GRAFANA_PORT=13000
# 既有ES端点无内嵌凭据；API key仅在私有.env注入，未启用认证时留空。
GITHUB_ES_URL=http://ES_PRIVATE_HOST:9200
GITHUB_ES_API_KEY=
# 官方固定版本；部署前保存目标架构的实际RepoDigest并覆盖这些值。
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.164.0
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
GRAFANA_IMAGE=grafana/grafana:13.3.0
JAEGER_IMAGE=jaegertracing/jaeger:2.23.0
