{
  "uid": "github-dev-fleet",
  "title": "个人 Java 微服务总览",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "预期9个Java服务与Engine采集状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "expr": "min(up{job=\"fleet-gateway\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "gateway",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-user\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "user",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-message\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "message",
          "refId": "C",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-ai\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "ai",
          "refId": "D",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-ai-agent\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "ai-agent",
          "refId": "E",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-ai-memory\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "ai-memory",
          "refId": "F",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-rag\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "rag",
          "refId": "G",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-report\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "report",
          "refId": "H",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-mcp\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "mcp",
          "refId": "I",
          "instant": true,
          "range": false
        },
        {
          "expr": "min(up{job=\"fleet-rag-engine\",environment=\"github-dev\"}) or vector(-1)",
          "legendFormat": "rag-engine",
          "refId": "J",
          "instant": true,
          "range": false
        }
      ],
      "description": "显示当前采集状态：1 为采集正常，0 为采集失败，-1 为预期目标未出现在 Prometheus 中。后两者均为红色；采集正常只证明指标端点可读，不等同于所有业务正常。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "未发现目标",
                  "color": "red"
                },
                "0": {
                  "text": "采集失败",
                  "color": "red"
                },
                "1": {
                  "text": "采集正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "HTTP请求速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "description": "过去 5 分钟 HTTP 请求速率，单位次/秒。新启动未形成两次采集、未收到 HTTP 请求或该指标未注册时可无数据；先检查上方采集状态。采集失败不会补为 0。"
    },
    {
      "id": 3,
      "title": "HTTP P95（秒；需启用分桶）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(application,le)(rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}}"
        }
      ],
      "description": "过去 5 分钟 HTTP 请求耗时 P95，单位秒。需要实际 http_server_requests 分桶和窗口内请求样本；无请求或分桶未加载时无数据，不能把缺少延迟样本当成 0 秒。"
    },
    {
      "id": 4,
      "title": "JVM堆占用",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ],
      "description": "Java 各服务当前 JVM 堆已用字节。正常 Java 目标应有该指标；缺失时检查采集状态、JVM 指标绑定与运行制品。Engine 为 Python 进程，不应出现在 JVM 面板。"
    },
    {
      "id": 5,
      "title": "Collector导出失败（含ES逐文档）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum by(exporter)(rate(otelcol_exporter_send_failed_spans{job=\"collector\"}[5m])) or on(exporter) ((0 * sum by(exporter)(rate(otelcol_exporter_sent_spans{job=\"collector\"}[5m]))) and on(exporter) sum by(exporter)(otelcol_exporter_sent_spans{job=\"collector\"}))) and on() (min(up{job=\"collector\"}) == 1)",
          "legendFormat": "{{exporter}}",
          "refId": "A"
        },
        {
          "expr": "(sum by(outcome)(rate({__name__=\"otelcol.elasticsearch.docs.processed\",job=\"collector\",outcome!=\"success\"}[5m])) or on() ((0 * sum(rate({__name__=\"otelcol.elasticsearch.docs.processed\",job=\"collector\",outcome=\"success\"}[5m]))) and on() sum({__name__=\"otelcol.elasticsearch.docs.processed\",job=\"collector\",outcome=\"success\"}))) and on() (min(up{job=\"collector\"}) == 1)",
          "legendFormat": "ES {{outcome}}",
          "refId": "B"
        }
      ],
      "description": "过去 5 分钟 Collector 链路导出失败与 Elasticsearch 逐文档非 success 速率，单位次/秒。错误标签尚未出现时，仅在当前 Collector 采集正常、对应成功输出计数器当前仍存在且有两次以上采集时显示 0；Collector 不可达、成功基线消失或样本不足仍无数据。ES 指标使用实际 UTF-8 带点名称；成功基线只用于补零，不能掩盖已出现的 timeout 等失败。"
    },
    {
      "id": 6,
      "title": "RAG检索结果（含降级与空命中）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(rag_engine_retrievals_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "description": "过去 5 分钟 Engine 检索结果速率，按 result 区分。计数器在首次出现相应业务结果后注册；未检索、新启动或尚未形成两次采集时可无数据，先核对 rag-engine 采集状态。无需为了填满看板重传文档或重建图谱。"
    },
    {
      "id": 7,
      "title": "图谱构建终态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(increase(rag_engine_graph_builds_total[1h]))",
          "legendFormat": "{{result}}"
        }
      ],
      "description": "过去 1 小时 Engine 已认领图谱构建的终态次数。计数器在实际任务终态时注册；当前进程没有构建或窗口内没有样本时可无数据，不代表已发布图谱丢失，也无需为看板重建图谱。"
    },
    {
      "id": 8,
      "title": "AI/RAG/MCP业务结果",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application,outcome)(rate({__name__=~\"ai_model_call_count_total|ai_agent_model_call_seconds_count|mcp_protocol_count_total|rag_retrieval_count_total\"}[5m]))",
          "legendFormat": "{{application}} {{outcome}}"
        }
      ],
      "description": "过去 5 分钟 AI、ai-agent、RAG 与 MCP 的真实业务结果速率。各计数器按实际调用及 outcome 懒注册；从未调用、新启动或采样不足时可无数据。先核对对应目标采集状态，不用模拟业务把未知结果填成成功。"
    },
    {
      "id": 9,
      "title": "Engine阶段P95（秒）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(stage,le)(rate(rag_engine_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "description": "过去 5 分钟 Engine 各阶段耗时 P95，单位秒。阶段直方图在实际执行后注册，且窗口内需有观测样本；阶段未执行或无请求时可无数据，不能补为 0 秒。"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "jaeger_ui_url",
        "type": "textbox",
        "label": "Jaeger搜索地址",
        "description": "浏览器可达的原生Jaeger地址；远程部署填写已核私网或受保护入口",
        "query": "http://localhost:16686",
        "current": {
          "text": "http://localhost:16686",
          "value": "http://localhost:16686"
        },
        "options": [
          {
            "selected": true,
            "text": "http://localhost:16686",
            "value": "http://localhost:16686"
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "完整链路搜索（Jaeger）",
      "url": "${jaeger_ui_url:raw}/search",
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "按服务、标签和时间搜索；Grafana Jaeger数据源用于Trace ID查询"
    },
    {
      "type": "link",
      "title": "运行日志（Explore / Elasticsearch）",
      "url": "/explore?schemaVersion=1&panes=%7B%22logs%22%3A%7B%22datasource%22%3A%22fleet-elasticsearch%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22elasticsearch%22%2C%22uid%22%3A%22fleet-elasticsearch%22%7D%2C%22query%22%3A%22Resource.deployment.environment.name%3A%5C%22github-dev%5C%22%22%2C%22metrics%22%3A%5B%7B%22id%22%3A%221%22%2C%22type%22%3A%22logs%22%2C%22settings%22%3A%7B%22limit%22%3A%22500%22%7D%7D%5D%2C%22bucketAggs%22%3A%5B%5D%2C%22timeField%22%3A%22%40timestamp%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D",
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "继承当前时间窗，默认 github-dev，最多500条。服务：Resource.service.name；链路：trace_id；级别：SeverityText。日志展开后点“查看链路”进入Jaeger。"
    }
  ]
}
