{
  "uid": "github-dev-fleet",
  "title": "个人 Java 微服务总览",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "预期9个Java服务与Engine采集状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "expr": "up{job=~\"fleet-.*\"}",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP请求速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP P95（秒；需启用分桶）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(application,le)(rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM堆占用",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Collector导出失败（含ES逐文档）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(otelcol_exporter_send_failed_spans[5m])",
          "legendFormat": "{{exporter}}",
          "refId": "A"
        },
        {
          "expr": "sum by(outcome,error_type)(rate(otelcol_elasticsearch_docs_processed{outcome!=\"success\"}[5m]))",
          "legendFormat": "ES {{outcome}} {{error_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "RAG检索结果（含降级与空命中）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(rag_engine_retrievals_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "图谱构建终态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(increase(rag_engine_graph_builds_total[1h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "AI/RAG/MCP业务结果",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application,outcome)(rate({__name__=~\"ai_model_call_count_total|ai_agent_model_call_seconds_count|mcp_protocol_count_total|rag_retrieval_count_total\"}[5m]))",
          "legendFormat": "{{application}} {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Engine阶段P95（秒）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(stage,le)(rate(rag_engine_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "jaeger_ui_url",
        "type": "textbox",
        "label": "Jaeger搜索地址",
        "description": "浏览器可达的原生Jaeger地址；远程部署填写已核私网或受保护入口",
        "query": "http://localhost:16686",
        "current": {
          "text": "http://localhost:16686",
          "value": "http://localhost:16686"
        },
        "options": [
          {
            "selected": true,
            "text": "http://localhost:16686",
            "value": "http://localhost:16686"
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "完整链路搜索（Jaeger）",
      "url": "${jaeger_ui_url:raw}/search",
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "按服务、标签和时间搜索；Grafana Jaeger数据源用于Trace ID查询"
    }
  ]
}
